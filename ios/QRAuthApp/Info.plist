<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>QRAuthApp</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!--
	  Google Sign-In (native) needs the app to handle the reversed form of its
	  iOS OAuth client ID as a custom URL scheme, e.g. for a client ID of
	  "1234567890-abc123.apps.googleusercontent.com" the reversed scheme is
	  "com.googleusercontent.apps.1234567890-abc123".

	  PLACEHOLDER: <IOS_CLIENT_ID> below must be replaced with the actual iOS
	  OAuth client ID created in Google Cloud Console (see
	  src/config/auth.ts / GOOGLE_IOS_CLIENT_ID) before Google Sign-In will
	  work on iOS. This entry is inert until then.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.&lt;IOS_CLIENT_ID&gt;</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Used to scan QR codes and barcodes to look up product information.</string>
	<!--
	  react-native-vector-icons font files (see src/components/AppLayout.tsx
	  and other screens) -- without these listed here AND added as Xcode
	  "Copy Bundle Resources", every icon in the app renders as a blank glyph
	  on a real iPhone. The .ttf files themselves still need to be added to
	  the QRAuthApp target in Xcode (drag node_modules/react-native-vector-icons/Fonts/*.ttf
	  into the project, checking "Copy items if needed" and the QRAuthApp target)
	  since that step can't be done from a plain text edit -- this only
	  declares the mapping deployment expects the app to have.
	-->
	<key>UIAppFonts</key>
	<array>
		<string>MaterialIcons.ttf</string>
		<string>Feather.ttf</string>
		<string>MaterialCommunityIcons.ttf</string>
	</array>
	<key>NFCReaderUsageDescription</key>
	<string>Used to read NFC tags to look up product information.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Used to tag corporate scan captures with the location where they were taken.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Used to scan a QR code or barcode from a photo in your library.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
